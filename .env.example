# Telegram bot token from @BotFather
TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Stripe keys (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret (from Stripe dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Path for the Stripe webhook (must match the URL you register in Stripe dashboard)
STRIPE_WEBHOOK_PATH=/stripe/webhook

# Random secret for signing session cookies (e.g. openssl rand -hex 32)
SESSION_SECRET=change_me_to_a_random_string

# Staff group chat ID (the barista group). Use /chatid to discover.
STAFF_CHAT_ID=-1001234567890

# Timezone (IANA name).
TZ=Asia/Singapore

# Path to the SQLite database file.
DB_PATH=/var/lib/coffee/data.db

# Comma-separated pickup time options in minutes (0 = ASAP).
PICKUP_OPTIONS=0,15,30,45

# ── Telegram Web App ──
# Public HTTPS URL for the embedded web app (must be HTTPS — Telegram requirement).
WEBAPP_PUBLIC_URL=https://your-domain.example.com/
# Address the web app HTTP server binds to (inside the container).
WEBAPP_LISTEN=:8083

# ── Telegram webhook ──
# Public HTTPS URL Telegram POSTs updates to. Include a secret path segment.
WEBHOOK_PUBLIC_URL=https://your-domain.example.com/tg/your-secret-path/
# Address the bot's webhook listener binds to.
WEBHOOK_LISTEN=:8080
# Secret token for the X-Telegram-Bot-Api-Secret-Token header.
WEBHOOK_SECRET_TOKEN=change_me_to_a_random_string

# Address of the /health endpoint.
HEALTH_LISTEN=:8081